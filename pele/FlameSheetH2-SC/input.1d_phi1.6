# 1D premixed H2/air flame, phi = 1.6, 1 atm, 300 K (verification of PeleLMeX + San Diego + MA transport
# against Cantera, before the triple flames). Narrow periodic strip, inflow at y = 0 at the Cantera sL,
# flame initially at y = 0.6 cm; sL_Pele = u_in - dy_flame/dt (post-processing PELE/tools/post_flamesheet.py).
geometry.is_periodic = 1 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0 0.0
geometry.prob_hi     = 4.0e-3 1.6e-2
peleLM.lo_bc = Interior Inflow
peleLM.hi_bc = Interior Outflow
amr.n_cell          = 32 128
amr.max_level       = 3
amr.ref_ratio       = 2 2 2
amr.regrid_int      = 5
amr.n_error_buf     = 2 2 2
amr.grid_eff        = 0.7
amr.blocking_factor = 8
amr.max_grid_size   = 32
prob.P_mean = 101325.0
prob.standoff = -0.014971
prob.pertmag = 0.0
pmf.datafile = "pmf_p1_T300_phi1.6_MA.dat"
peleLM.v = 1
peleLM.use_wbar = 1
peleLM.sdc_iterMax = 2
peleLM.num_init_iter = 3
peleLM.do_temporals = 1
peleLM.temporal_int = 10
peleLM.do_extremas = 1
amr.stop_time = 2.0e-3
amr.max_wall_time = 2.0
amr.cfl = 0.5
amr.dt_shrink = 0.01
amr.dt_change_max = 1.1
amr.plot_per = 1.0e-4
amr.check_per = 5.0e-4
amr.derive_plot_vars = mass_fractions
peleLM.fuel_name = H2
peleLM.chem_integrator = "ReactorCvode"
peleLM.use_typ_vals_chem = 1
ode.rtol = 1.0e-6
ode.atol = 1.0e-5
cvode.solve_type = denseAJ_direct
cvode.max_order  = 4
amr.refinement_indicators = gradT
amr.gradT.max_level = 3
amr.gradT.adjacent_difference_greater = 15.0
amr.gradT.field_name = temp
nodal_proj.verbose = 0
nodal_proj.rtol = 1.0e-10
nodal_proj.atol = 1.0e-10
mac_proj.rtol = 1.0e-10
mac_proj.atol = 1.0e-12
# constant-Schmidt transport (constant Schmidt numbers, Chaplet et al. Table 1; power-law viscosity and Pr fitted at phi = 1.6, chem/transport/Sc.json; CGS)
transport.viscosity_mu_ref = 1.824792685807555e-4
transport.viscosity_T_ref = 300.0
transport.viscosity_power = 0.6753244478999778
transport.Prandtl_number = 0.5072290912075725
transport.schmidt_numbers = 0.91 0.14 0.80 0.53 0.52 0.23 0.58 0.80 0.81
transport.const_bulk_viscosity = 0.0
